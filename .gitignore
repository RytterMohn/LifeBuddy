# APKs and local release/device verification records belong outside Git
/releases/
*.apk
*.aab
*.apks

# Keep historical device logs/screenshots local; publish curated documentation only
/docs/*
!/docs/getting-started.md
!/docs/architecture.md
!/docs/extensions.md
!/docs/development.md
!/docs/testing.md
!/docs/releases.md

# Earlier logo drafts and internal previews
/design/lifebuddy/logo-options/
/design/lifebuddy/application-preview.*

# Python scratch state
__pycache__/
*.pyc
.venv/
